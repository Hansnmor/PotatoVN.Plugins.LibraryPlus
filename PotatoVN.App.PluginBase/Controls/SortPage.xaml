<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PotatoVN.App.PluginBase.Controls.SortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:prefabs="using:PotatoVN.App.PluginBase.Controls.Prefabs"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- 游戏右键菜单（与原生游戏库页一致） -->
        <MenuFlyout x:Name="GameFlyout" Opening="GameFlyout_Opening">
            <MenuFlyoutSubItem Text="游玩状态">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74C;" />
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Name="StatusPlaying" Text="游玩中" GroupName="SortPagePlayStatus"
                                     CommandParameter="Playing" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusPlayed" Text="已玩过" GroupName="SortPagePlayStatus"
                                     CommandParameter="Played" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusShelved" Text="搁置" GroupName="SortPagePlayStatus"
                                     CommandParameter="Shelved" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusAbandoned" Text="抛弃" GroupName="SortPagePlayStatus"
                                     CommandParameter="Abandoned" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusWantToPlay" Text="想玩" GroupName="SortPagePlayStatus"
                                     CommandParameter="WantToPlay" Click="ChangePlayStatus_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Icon="Edit" Text="编辑游戏信息" Click="EditGame_Click" />
            <MenuFlyoutItem Icon="Download" Text="下载游戏信息" Click="FetchInfo_Click" />
            <MenuFlyoutItem Icon="OpenLocal" Text="在文件管理器中打开" x:Name="OpenInExplorerItem" Click="OpenInExplorer_Click" />
            <MenuFlyoutItem Icon="Delete" Text="从游戏库删除" Click="RemoveGame_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：排序（唯一与原页面的差异） -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Sort" Label="排序">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <!-- 主排序键 -->
                        <RadioMenuFlyoutItem x:Name="PrimaryDefault" Text="默认顺序" GroupName="SortPrimary"
                                             CommandParameter="Default" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryExpected" Text="按预计时长" GroupName="SortPrimary"
                                             CommandParameter="ExpectedPlayTime" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryPlayTime" Text="按游玩时间" GroupName="SortPrimary"
                                             CommandParameter="PlayTime" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryPlayCount" Text="按游玩次数" GroupName="SortPrimary"
                                             CommandParameter="PlayCount" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryMyRate" Text="按我的评分" GroupName="SortPrimary"
                                             CommandParameter="MyRate" Click="PrimaryKey_Click" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="PrimaryDescendingItem" Text="主键降序" Click="PrimaryDescending_Click" />
                        <MenuFlyoutSeparator />
                        <!-- 第二排序键 -->
                        <MenuFlyoutSubItem Text="第二排序键">
                            <RadioMenuFlyoutItem x:Name="SecondaryDefault" Text="无" GroupName="SortSecondary"
                                                 CommandParameter="Default" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryExpected" Text="按预计时长" GroupName="SortSecondary"
                                                 CommandParameter="ExpectedPlayTime" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryPlayTime" Text="按游玩时间" GroupName="SortSecondary"
                                                 CommandParameter="PlayTime" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryPlayCount" Text="按游玩次数" GroupName="SortSecondary"
                                                 CommandParameter="PlayCount" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryMyRate" Text="按我的评分" GroupName="SortSecondary"
                                                 CommandParameter="MyRate" Click="SecondaryKey_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="SecondaryDescendingItem" Text="次键降序" Click="SecondaryDescending_Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <!-- 状态筛选（包含式：勾选=只显示勾选的状态；顶部快捷预设；IsChecked 由代码在菜单打开时同步，
                 避免插件 LoadComponent 下 IsChecked 字面量解析失败） -->
            <AppBarButton Icon="Filter" Label="筛选">
                <AppBarButton.Flyout>
                    <MenuFlyout Opening="FilterMenu_Opening">
                        <!-- 快捷预设 -->
                        <RadioMenuFlyoutItem x:Name="FilterAll" Text="全部" GroupName="SortPageFilter"
                                             CommandParameter="All" Click="FilterPreset_Click" />
                        <RadioMenuFlyoutItem x:Name="FilterToPlay" Text="待玩（未标记+游玩中+想玩）" GroupName="SortPageFilter"
                                             CommandParameter="ToPlay" Click="FilterPreset_Click" />
                        <RadioMenuFlyoutItem x:Name="FilterCustom" Text="自定义" GroupName="SortPageFilter"
                                             CommandParameter="Custom" Click="FilterPreset_Click" />
                        <MenuFlyoutSeparator />
                        <!-- 自定义：勾选=只显示这些状态 -->
                        <ToggleMenuFlyoutItem x:Name="IncludeNone" Text="未标记" CommandParameter="None" Click="FilterState_Click" />
                        <ToggleMenuFlyoutItem x:Name="IncludePlaying" Text="游玩中" CommandParameter="Playing" Click="FilterState_Click" />
                        <ToggleMenuFlyoutItem x:Name="IncludePlayed" Text="已玩过" CommandParameter="Played" Click="FilterState_Click" />
                        <ToggleMenuFlyoutItem x:Name="IncludeShelved" Text="搁置" CommandParameter="Shelved" Click="FilterState_Click" />
                        <ToggleMenuFlyoutItem x:Name="IncludeAbandoned" Text="抛弃" CommandParameter="Abandoned" Click="FilterState_Click" />
                        <ToggleMenuFlyoutItem x:Name="IncludeWantToPlay" Text="想玩" CommandParameter="WantToPlay" Click="FilterState_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.Content>
                <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center"
                           Style="{ThemeResource BodyTextStyle}" Margin="12,0,0,0" />
            </CommandBar.Content>
        </CommandBar>

        <!-- 时长区间筛选（左）+ 时长统计（右） -->
        <Grid Grid.Row="1" Margin="12,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 区间按钮组：<10h 短篇小品 / 10-20h 单线 / 20-40h 中等 / >40h 长篇 -->
            <!-- 注意：不要在 XAML 里给 RadioButton 写 IsChecked 字面量（插件 LoadComponent 路径下
                 ToggleButton.IsChecked 赋值会 XamlParseException），选中状态统一由代码 RestoreRangeState 设置 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <RadioButton x:Name="RangeAll" Content="全部" GroupName="DurationRange" Tag="All"
                             Checked="Range_Click" />
                <RadioButton x:Name="RangeUnder10" Content="&lt;10h" GroupName="DurationRange" Tag="Under10"
                             Checked="Range_Click" />
                <RadioButton x:Name="Range10To20" Content="10-20h" GroupName="DurationRange" Tag="10to20"
                             Checked="Range_Click" />
                <RadioButton x:Name="Range20To40" Content="20-40h" GroupName="DurationRange" Tag="20to40"
                             Checked="Range_Click" />
                <RadioButton x:Name="RangeOver40" Content="&gt;40h" GroupName="DurationRange" Tag="Over40"
                             Checked="Range_Click" />
                <!-- 与四档时长隔开一段间距 -->
                <Rectangle Width="12" Height="1" VerticalAlignment="Center" />
                <RadioButton x:Name="RangeUnknown" Content="时长未知" GroupName="DurationRange" Tag="Unknown"
                             Checked="Range_Click" />
            </StackPanel>

            <!-- 统计（跟随当前可见列表）：预计总时长 / 完成度 / 时长未知数 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TotalTimeText" Style="{ThemeResource BodyTextStyle}" />
                <TextBlock x:Name="ProgressText" Style="{ThemeResource BodyTextStyle}" />
                <TextBlock x:Name="UnknownTimeText" Style="{ThemeResource BodyTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- 游戏网格（与原生一致的卡片尺寸与自适应布局） -->
        <GridView
            Grid.Row="2" x:Name="GameGridView"
            IsItemClickEnabled="True"
            SelectionMode="None"
            IsMultiSelectCheckBoxEnabled="False"
            ItemClick="GameGridView_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Galgame">
                    <prefabs:GalgamePrefab
                        Galgame="{x:Bind}"
                        PlayTypeVisibility="Visible"
                        Flyout="{StaticResource GameFlyout}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
