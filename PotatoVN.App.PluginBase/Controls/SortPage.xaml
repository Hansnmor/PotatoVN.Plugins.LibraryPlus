<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PotatoVN.App.PluginBase.Controls.SortPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:GalgameManager.Models"
    xmlns:prefabs="using:PotatoVN.App.PluginBase.Controls.Prefabs"
    mc:Ignorable="d">

    <!-- 注：不用 Page.KeyboardAccelerators 做 Ctrl+F——WinUI 3 会把 Page 级加速器文本附加到
         页面上所有控件的 ToolTip（悬停封面冒 "Ctrl+F" 悬浮框）；且用户确认不需要快捷键，点按钮即可 -->

    <Page.Resources>
        <!-- 游戏右键菜单（与原生游戏库页一致） -->
        <MenuFlyout x:Name="GameFlyout" Opening="GameFlyout_Opening">
            <MenuFlyoutSubItem Text="游玩状态">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74C;" />
                </MenuFlyoutSubItem.Icon>
                <RadioMenuFlyoutItem x:Name="StatusPlaying" Text="游玩中" GroupName="SortPagePlayStatus"
                                     CommandParameter="Playing" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusPlayed" Text="已玩过" GroupName="SortPagePlayStatus"
                                     CommandParameter="Played" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusShelved" Text="搁置" GroupName="SortPagePlayStatus"
                                     CommandParameter="Shelved" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusAbandoned" Text="抛弃" GroupName="SortPagePlayStatus"
                                     CommandParameter="Abandoned" Click="ChangePlayStatus_Click" />
                <RadioMenuFlyoutItem x:Name="StatusWantToPlay" Text="想玩" GroupName="SortPagePlayStatus"
                                     CommandParameter="WantToPlay" Click="ChangePlayStatus_Click" />
            </MenuFlyoutSubItem>
            <!-- 内容分类（手动覆盖自动分类，持久化生效；与右键菜单同款单选组） -->
            <MenuFlyoutSubItem Text="分类">
                <RadioMenuFlyoutItem x:Name="CatAuto" Text="自动分类" GroupName="SortPageCategory"
                                     CommandParameter="Auto" Click="SetCategory_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="CatMoe" Text="萌作" GroupName="SortPageCategory"
                                     CommandParameter="Moe" Click="SetCategory_Click" />
                <RadioMenuFlyoutItem x:Name="CatStory" Text="剧情作" GroupName="SortPageCategory"
                                     CommandParameter="Story" Click="SetCategory_Click" />
                <RadioMenuFlyoutItem x:Name="CatNukige" Text="拔作" GroupName="SortPageCategory"
                                     CommandParameter="Nukige" Click="SetCategory_Click" />
                <RadioMenuFlyoutItem x:Name="CatOther" Text="其他" GroupName="SortPageCategory"
                                     CommandParameter="Other" Click="SetCategory_Click" />
            </MenuFlyoutSubItem>
            <!-- 形态（手动覆盖自动形态判定，持久化生效） -->
            <MenuFlyoutSubItem Text="形态">
                <RadioMenuFlyoutItem x:Name="FormAuto" Text="自动形态" GroupName="SortPageForm"
                                     CommandParameter="Auto" Click="SetForm_Click" />
                <MenuFlyoutSeparator />
                <RadioMenuFlyoutItem x:Name="FormTrad" Text="传统ADV" GroupName="SortPageForm"
                                     CommandParameter="TraditionalAdv" Click="SetForm_Click" />
                <RadioMenuFlyoutItem x:Name="FormNonTrad" Text="非传统ADV" GroupName="SortPageForm"
                                     CommandParameter="NonTraditionalAdv" Click="SetForm_Click" />
            </MenuFlyoutSubItem>
            <MenuFlyoutItem Icon="Edit" Text="编辑游戏信息" Click="EditGame_Click" />
            <MenuFlyoutItem Icon="Download" Text="下载游戏信息" Click="FetchInfo_Click" />
            <MenuFlyoutItem Icon="OpenLocal" Text="在文件管理器中打开" x:Name="OpenInExplorerItem" Click="OpenInExplorer_Click" />
            <MenuFlyoutItem Icon="Delete" Text="从游戏库删除" Click="RemoveGame_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：排序（唯一与原页面的差异）；IsDynamicOverflowEnabled=False 防止按钮被折叠进溢出菜单（保证搜索按钮坐标稳定） -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="False">
            <!-- 功能说明（放第一个，避免被 CommandBar 折叠进溢出菜单）；x:Name 供搜索按钮做高度对齐基准 -->
            <AppBarButton x:Name="HelpButton" Label="功能说明" Click="Help_Click" ToolTipService.ToolTip="插件功能简介">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE897;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!-- 搜索入口：AppBarButton 与搜索框重叠于同一容器（原生 InlineSearchAutoSuggestBox 结构，位置天然正确）；
                 按钮 Content 自绘横排一行，Height 钳制到 AppBarButton 标准高度 -->
            <AppBarElementContainer>
                <Grid>
                    <!-- Height 不写死：页面 Loaded 后按 HelpButton 实际高度对齐（宿主主题不同，按钮高度可能非 40） -->
                    <AppBarButton x:Name="SearchButton" VerticalAlignment="Center" Click="SearchToggle_Click"
                                  ToolTipService.ToolTip="搜索游戏（名称/中文名/原名/开发商/标签）">
                        <AppBarButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="16" />
                                <TextBlock Text="搜索" VerticalAlignment="Center" />
                            </StackPanel>
                        </AppBarButton.Content>
                    </AppBarButton>
                    <!-- 高度由代码设置（紧凑输入框高度 32，居中于按钮区域，与宿主主页原生搜索框观感一致；
                         不能对齐到按钮控件高度 48——按钮可见内容只有图标+文字约 20 高，48 高实心输入框
                         视觉会凸出近两倍）。MinHeight=0 防止宿主主题最小高度把紧凑高度撑破。
                         本 Border 只做宽度动画容器：不加 Background/Padding/CornerRadius——
                         加背景会在 AutoSuggestBox 周围露边，形成左右两条半透明圆角浅色块（用户截图确认） -->
                    <Border x:Name="SearchOverlay" Width="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <!-- 无 QueryIcon：与原生 InlineSearchAutoSuggestBox 一致（原生展开后右侧是 × 清除按钮，不是放大镜） -->
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索游戏" VerticalAlignment="Stretch" MinHeight="0"
                                        TextChanged="SearchBox_TextChanged" LostFocus="SearchBox_LostFocus" />
                    </Border>
                </Grid>
            </AppBarElementContainer>
            <AppBarButton Icon="Sort" Label="排序">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <!-- 主排序键 -->
                        <RadioMenuFlyoutItem x:Name="PrimaryDefault" Text="默认顺序" GroupName="SortPrimary"
                                             CommandParameter="Default" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryExpected" Text="按预计时长" GroupName="SortPrimary"
                                             CommandParameter="ExpectedPlayTime" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryPlayTime" Text="按游玩时间" GroupName="SortPrimary"
                                             CommandParameter="PlayTime" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryPlayCount" Text="按游玩次数" GroupName="SortPrimary"
                                             CommandParameter="PlayCount" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryMyRate" Text="按我的评分" GroupName="SortPrimary"
                                             CommandParameter="MyRate" Click="PrimaryKey_Click" />
                        <RadioMenuFlyoutItem x:Name="PrimaryWeightedScore" Text="按加权评分" GroupName="SortPrimary"
                                             CommandParameter="WeightedScore" Click="PrimaryKey_Click" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="PrimaryDescendingItem" Text="主键降序" Click="PrimaryDescending_Click" />
                        <MenuFlyoutSeparator />
                        <!-- 第二排序键 -->
                        <MenuFlyoutSubItem Text="第二排序键">
                            <RadioMenuFlyoutItem x:Name="SecondaryDefault" Text="无" GroupName="SortSecondary"
                                                 CommandParameter="Default" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryExpected" Text="按预计时长" GroupName="SortSecondary"
                                                 CommandParameter="ExpectedPlayTime" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryPlayTime" Text="按游玩时间" GroupName="SortSecondary"
                                                 CommandParameter="PlayTime" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryPlayCount" Text="按游玩次数" GroupName="SortSecondary"
                                                 CommandParameter="PlayCount" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryMyRate" Text="按我的评分" GroupName="SortSecondary"
                                                 CommandParameter="MyRate" Click="SecondaryKey_Click" />
                            <RadioMenuFlyoutItem x:Name="SecondaryWeightedScore" Text="按加权评分" GroupName="SortSecondary"
                                                 CommandParameter="WeightedScore" Click="SecondaryKey_Click" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="SecondaryDescendingItem" Text="次键降序" Click="SecondaryDescending_Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <!-- 状态筛选（包含式：勾选=只显示勾选的状态；顶部快捷预设）。
                 用 Flyout+StackPanel 而非 MenuFlyout：MenuFlyout 只能放 MenuFlyoutItemBase，
                 CheckBox/RadioButton 点击不关闭菜单，可一次勾选多个后统一生效 -->
            <AppBarButton Icon="Filter" Label="筛选">
                <AppBarButton.Flyout>
                    <Flyout Opened="FilterMenu_Opening">
                        <StackPanel Spacing="2" MinWidth="200">
                            <RadioButton x:Name="FilterAll" Content="全部" GroupName="SortPageFilter" Tag="All"
                                         Click="FilterPreset_Click" />
                            <RadioButton x:Name="FilterToPlay" Content="待玩（未标记+游玩中+想玩）" GroupName="SortPageFilter" Tag="ToPlay"
                                         Click="FilterPreset_Click" />
                            <RadioButton x:Name="FilterCustom" Content="自定义" GroupName="SortPageFilter" Tag="Custom"
                                         Click="FilterPreset_Click" />
                            <Rectangle Height="1" Margin="0,6,0,4"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <!-- 自定义：勾选=只显示这些状态 -->
                            <CheckBox x:Name="IncludeNone" Content="未标记" Tag="None" Click="FilterState_Click" />
                            <CheckBox x:Name="IncludePlaying" Content="游玩中" Tag="Playing" Click="FilterState_Click" />
                            <CheckBox x:Name="IncludePlayed" Content="已玩过" Tag="Played" Click="FilterState_Click" />
                            <CheckBox x:Name="IncludeShelved" Content="搁置" Tag="Shelved" Click="FilterState_Click" />
                            <CheckBox x:Name="IncludeAbandoned" Content="抛弃" Tag="Abandoned" Click="FilterState_Click" />
                            <CheckBox x:Name="IncludeWantToPlay" Content="想玩" Tag="WantToPlay" Click="FilterState_Click" />
                        </StackPanel>
                    </Flyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <!-- 注意：Icon 不用 Symbol 简写（宿主旧 WinUI 的 Symbol 枚举可能缺成员，曾导致 XamlParseException），统一 FontIcon -->
            <AppBarToggleButton x:Name="MultiSelectToggle" Label="多选"
                                Click="MultiSelectToggle_Click"
                                ToolTipService.ToolTip="开启后勾选游戏，批量搜刮将只作用于选中的游戏">
                <AppBarToggleButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE762;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton x:Name="BatchScrapeButton" Icon="Download" Label="更多搜刮" Click="BatchScrape_Click" ToolTipService.ToolTip="对当前筛选的游戏批量用 kungal 搜刮（中文简介 + 标签）" />
            <AppBarButton x:Name="BatchRatingButton" Label="计算评分" Click="BatchRating_Click" ToolTipService.ToolTip="批量拉取 bangumi / vndb 官方评分，生成加权综合评分（供排序与详情页卡片使用）">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE735;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!-- 更多工具：显示设置（非本地游戏）+ 游玩记录（启动守卫/清除记录）+ 插件数据备份。
                 ToggleMenuFlyoutItem/RadioMenuFlyoutItem 的选中态一律代码设置（Opening 同步），XAML 不写字面量 -->
            <AppBarButton x:Name="MoreToolButton" Label="更多" ToolTipService.ToolTip="显示设置、游玩记录工具与插件数据备份">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE81C;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout Opening="MoreMenu_Opening">
                        <ToggleMenuFlyoutItem x:Name="ShowVirtualGameItem" Text="显示非本地游戏"
                                              Click="ShowVirtualGame_Click"
                                              ToolTipService.ToolTip="库里有条目、但本机已没有游戏文件的记录（云同步换机后常见，原生称「虚拟游戏」）。默认不显示，也不参与统计与批量操作" />
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem x:Name="GuardToggleItem" Text="启动守卫（试玩不上前排）"
                                              Click="GuardToggle_Click"
                                              ToolTipService.ToolTip="短开游戏未达阈值即退出时，自动还原「上次游玩时间」，防止原生主页排序被污染" />
                        <MenuFlyoutSubItem Text="守卫阈值（真玩达标才放行）">
                            <RadioMenuFlyoutItem x:Name="GuardThreshold5" Text="5 分钟（默认）" Tag="5"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                            <RadioMenuFlyoutItem x:Name="GuardThreshold10" Text="10 分钟" Tag="10"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                            <RadioMenuFlyoutItem x:Name="GuardThreshold15" Text="15 分钟" Tag="15"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                            <RadioMenuFlyoutItem x:Name="GuardThreshold20" Text="20 分钟" Tag="20"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                            <RadioMenuFlyoutItem x:Name="GuardThreshold30" Text="30 分钟" Tag="30"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                            <RadioMenuFlyoutItem x:Name="GuardThreshold60" Text="60 分钟" Tag="60"
                                                 GroupName="GuardThreshold" Click="GuardThreshold_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="清除游玩记录…" Click="ClearPlayRecord_Click"
                                        ToolTipService.ToolTip="清除勾选（或当前筛选）游戏的游玩明细/累计时长/上次游玩时间" />
                        <MenuFlyoutItem Text="导出插件数据…" Click="ExportData_Click"
                                        ToolTipService.ToolTip="把本插件的设置、手动分类覆盖、搜刮与评分缓存导出为 JSON 备份（防误删）" />
                        <MenuFlyoutItem Text="导入插件数据…" Click="ImportData_Click"
                                        ToolTipService.ToolTip="从导出的 JSON 备份整体恢复插件数据（覆盖当前，需确认）" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="CountTextBlock" VerticalAlignment="Center"
                               Style="{ThemeResource BodyTextStyle}" Margin="12,0,0,0" />
                    <TextBlock x:Name="CategoryStatsText" VerticalAlignment="Center"
                               Style="{ThemeResource BodyTextStyle}" />
                    <TextBlock x:Name="BatchProgressText" VerticalAlignment="Center"
                               Style="{ThemeResource BodyTextStyle}" Margin="12,0,0,0" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!-- 时长区间筛选（左）+ 时长统计（右） -->
        <Grid Grid.Row="1" Margin="12,4,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 区间按钮组：<10h 短篇小品 / 10-20h 单线 / 20-40h 中等 / >40h 长篇 -->
            <!-- 注意：不要在 XAML 里给 RadioButton 写 IsChecked 字面量（插件 LoadComponent 路径下
                 ToggleButton.IsChecked 赋值会 XamlParseException），选中状态统一由代码 RestoreRangeState 设置 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <RadioButton x:Name="RangeAll" Content="时长：全部" GroupName="DurationRange" Tag="All"
                             Checked="Range_Click" />
                <RadioButton x:Name="RangeUnder10" Content="&lt;10h" GroupName="DurationRange" Tag="Under10"
                             Checked="Range_Click" />
                <RadioButton x:Name="Range10To20" Content="10-20h" GroupName="DurationRange" Tag="10to20"
                             Checked="Range_Click" />
                <RadioButton x:Name="Range20To40" Content="20-40h" GroupName="DurationRange" Tag="20to40"
                             Checked="Range_Click" />
                <RadioButton x:Name="RangeOver40" Content="&gt;40h" GroupName="DurationRange" Tag="Over40"
                             Checked="Range_Click" />
                <!-- 与四档时长隔开一段间距 -->
                <Rectangle Width="12" Height="1" VerticalAlignment="Center" />
                <RadioButton x:Name="RangeUnknown" Content="时长未知" GroupName="DurationRange" Tag="Unknown"
                             Checked="Range_Click" />
            </StackPanel>

            <!-- 统计（跟随当前可见列表）：预计总时长 / 完成度 / 时长未知数 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TotalTimeText" Style="{ThemeResource BodyTextStyle}" />
                <TextBlock x:Name="ProgressText" Style="{ThemeResource BodyTextStyle}" />
                <TextBlock x:Name="UnknownTimeText" Style="{ThemeResource BodyTextStyle}" />
            </StackPanel>

            <!-- 内容轴分类按钮组：萌作/剧情作/拔作/其他（v2 双轴体系，同人作退役，同人游戏按内容/形态重新归类） -->
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        Margin="0,6,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="CategoryAll" Content="类型：全部" GroupName="GameCategory" Tag="All"
                             Checked="Category_Click" />
                <RadioButton x:Name="CategoryMoe" Content="萌作" GroupName="GameCategory" Tag="Moe"
                             Checked="Category_Click" />
                <RadioButton x:Name="CategoryStory" Content="剧情作" GroupName="GameCategory" Tag="Story"
                             Checked="Category_Click" />
                <RadioButton x:Name="CategoryNukige" Content="拔作" GroupName="GameCategory" Tag="Nukige"
                             Checked="Category_Click" />
                <RadioButton x:Name="CategoryOther" Content="其他" GroupName="GameCategory" Tag="Other"
                             Checked="Category_Click" />
            </StackPanel>

            <!-- 形态轴分类按钮组：传统ADV / 非传统ADV（SLG/RPG 等玩法形态） -->
            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        Margin="0,6,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="FormAll" Content="形态：全部" GroupName="GameForm" Tag="All"
                             Checked="Form_Click" />
                <RadioButton x:Name="FormTraditional" Content="传统ADV" GroupName="GameForm" Tag="TraditionalAdv"
                             Checked="Form_Click" />
                <RadioButton x:Name="FormNonTraditional" Content="非传统ADV" GroupName="GameForm" Tag="NonTraditionalAdv"
                             Checked="Form_Click" />
            </StackPanel>
        </Grid>

        <!-- 游戏网格（与原生一致的卡片尺寸与自适应布局） -->
        <GridView
            Grid.Row="2" x:Name="GameGridView"
            IsItemClickEnabled="True"
            SelectionMode="None"
            IsMultiSelectCheckBoxEnabled="False"
            ItemClick="GameGridView_ItemClick"
            SelectionChanged="GameGridView_SelectionChanged">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:Galgame">
                    <prefabs:GalgamePrefab
                        Galgame="{x:Bind}"
                        PlayTypeVisibility="Visible"
                        Flyout="{StaticResource GameFlyout}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
